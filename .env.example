# Địa chỉ máy chủ AI của trường mà trình duyệt gọi tới.
# Production (Vercel): URL HTTPS của Cloudflare Tunnel, ví dụ https://camera-api.locaith.ai
# Chạy thử trên chính máy chủ: http://127.0.0.1:8100
NEXT_PUBLIC_API_URL=https://camera-api.locaith.ai

# Tuỳ chọn: Google OAuth Client ID (mặc định lấy từ máy chủ qua /api/health)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
